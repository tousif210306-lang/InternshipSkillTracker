# DB_URL must be Aiven's JDBC URL without credentials and with TLS enabled.
# Example shape: jdbc:mysql://<AIVEN_HOST>:<PORT>/<DATABASE>?sslMode=REQUIRED
# Copy these keys into Render's Environment settings. Keep real values private.
SPRING_PROFILES_ACTIVE=prod
DB_URL=
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
FRONTEND_URL=
